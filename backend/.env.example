# ---------------------------------------------------------------------------
# TEMPLATE ONLY -- this file IS committed to Git and must contain NO real
# secrets. Copy it to `.env` (which is git-ignored) and fill in real values:
#
#     cp .env.example .env
# ---------------------------------------------------------------------------

APP_NAME="Personal Finance API"
ENVIRONMENT=local
DEBUG=true

# The exact origin your frontend runs on. No trailing slash.
FRONTEND_ORIGIN=http://localhost:3000

# Local Postgres started by docker-compose.yml at the repo root.
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance

# --- Authentication (Clerk) ---
# Found in the Clerk dashboard under Configure > API keys, as the
# "Frontend API URL" / JWT issuer. Looks like:
#   https://enough-mammal-42.clerk.accounts.dev
# Leave blank to run without authentication (local development only -- the
# app refuses to start in production without it).
CLERK_ISSUER=

# Origins allowed to mint tokens for this API. In development this is your
# frontend's URL; in production it is your real domain. JSON array.
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]

# Optional. Derived from CLERK_ISSUER automatically; only set this if your
# Clerk instance serves its keys from a non-standard location.
# CLERK_JWKS_URL=

# --- Added in later milestones; listed here so you know what is coming ---
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
