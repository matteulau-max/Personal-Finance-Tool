# ---------------------------------------------------------------------------
# TEMPLATE ONLY -- this file IS committed to Git and must contain NO real
# secrets. Copy it to `.env` (which is git-ignored) and fill in real values:
#
#     cp .env.example .env
# ---------------------------------------------------------------------------

APP_NAME="Personal Finance API"
ENVIRONMENT=local
DEBUG=true

# The exact origin your frontend runs on. No trailing slash.
FRONTEND_ORIGIN=http://localhost:3000

# Local Postgres started by docker-compose.yml at the repo root.
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance

# --- Authentication (Clerk) ---
# Found in the Clerk dashboard under Configure > API keys, as the
# "Frontend API URL" / JWT issuer. Looks like:
#   https://enough-mammal-42.clerk.accounts.dev
# Leave blank to run without authentication (local development only -- the
# app refuses to start in production without it).
CLERK_ISSUER=

# Origins allowed to mint tokens for this API. In development this is your
# frontend's URL; in production it is your real domain. JSON array.
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]

# Optional. Derived from CLERK_ISSUER automatically; only set this if your
# Clerk instance serves its keys from a non-standard location.
# CLERK_JWKS_URL=

# --- Encryption at rest ---
# Fernet keys, NEWEST FIRST. The first encrypts new data; the rest let data
# written under older keys still decrypt during a rotation.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored Plaid access token unreadable and every
# bank connection unusable. Back it up somewhere other than this repository.
ENCRYPTION_KEYS=["replace-with-a-generated-fernet-key"]

# --- Plaid ---
# From the Plaid dashboard: Developers > Keys.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox = fake banks, test credentials, free. Start here.
PLAID_ENV=sandbox
PLAID_PRODUCTS=["transactions"]
PLAID_COUNTRY_CODES=["US"]
PLAID_CLIENT_NAME="Personal Finance Dashboard"

# Public HTTPS URL Plaid posts webhooks to. Leave empty in local development:
# Plaid cannot reach localhost, and syncing works fine without it.
PLAID_WEBHOOK_URL=

# --- AI insights (Anthropic) ---
# From https://console.anthropic.com -> API Keys.
#
# LEAVE THIS EMPTY to keep the feature switched off. Unset means /api/insights
# returns 503 -- it never falls back to answering without the data layer, and
# nothing about your finances is sent anywhere.
#
# When set, questions asked on /insights send aggregates, merchant names, and
# (for "show me my restaurant charges" style questions) transaction
# descriptions to Anthropic's API. Access tokens, account numbers and raw
# Plaid payloads are not sent, because no tool returns them.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
