# ---------------------------------------------------------------------------
# TEMPLATE ONLY -- this file IS committed to Git and must contain NO real
# secrets. Copy it to `.env` (which is git-ignored) and fill in real values:
#
#     cp .env.example .env
# ---------------------------------------------------------------------------

APP_NAME="Personal Finance API"
ENVIRONMENT=local
DEBUG=true

# The exact origin your frontend runs on. No trailing slash.
FRONTEND_ORIGIN=http://localhost:3000

# Local Postgres started by docker-compose.yml at the repo root.
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance

# --- Added in later milestones; listed here so you know what is coming ---
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# CLERK_SECRET_KEY=
