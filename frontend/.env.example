# TEMPLATE ONLY -- committed to Git, contains no secrets.
# Copy to `.env.local` (git-ignored) for your machine:
#
#     cp .env.example .env.local

# Where the FastAPI backend lives. Server-side only: because this name does
# NOT start with NEXT_PUBLIC_, it is never sent to the browser.
API_BASE_URL=http://localhost:8000

# --- Clerk ---
# From the Clerk dashboard, Configure > API keys.
#
# The PUBLISHABLE key is safe in the browser -- that is what NEXT_PUBLIC_
# means, and Clerk designed it to be public.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# The SECRET key must NEVER be exposed. Note it deliberately has no
# NEXT_PUBLIC_ prefix: adding one would bundle it into JavaScript served to
# every visitor, handing over full control of your Clerk instance.
CLERK_SECRET_KEY=

# Where Clerk's prebuilt components live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Note: there is deliberately no Plaid configuration here.
# Plaid credentials live ONLY in the backend. The browser never holds anything
# beyond a short-lived link token and a single-use public token, both of which
# are fetched through our own API.
